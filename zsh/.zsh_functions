#!/bin/zsh

# check all git repos in ~/code for uncommitted or unpushed changes
gsa() {
  find "$REPOS" -type d -name ".git" 2>/dev/null | while read gitdir; do
    repo_dir="${gitdir%.git}"

    # check for uncommitted changes
    if [[ -n $(git -C "$repo_dir" status --porcelain) ]]; then
      echo "📝 ${repo_dir#$HOME/code/} - dirty"
      continue
    fi

    # check for unpushed commits
    local branch=$(git -C "$repo_dir" rev-parse --abbrev-ref HEAD 2>/dev/null)
    if [[ -n "$branch" ]]; then
      local unpushed=$(git -C "$repo_dir" log origin/$branch..HEAD 2>/dev/null | wc -l)
      if [[ $unpushed -gt 0 ]]; then
        echo "⬆️  ${repo_dir#$HOME/code/} - unpushed ($unpushed)"
      fi
    fi
  done
}

# clone git repo to organized structure
clone() {
  # strip protocol and www. from url
  local repo_path=${1#*//}
  repo_path=${repo_path#www.}
  local target_dir="$HOME/code/${repo_path%.git}"

  if [[ ! -d "$target_dir" ]]; then
    # create parent dirs, then clone
    mkdir -p "${target_dir:h}" && git clone "$1" "$target_dir"
  fi

  # always cd to the repo directory
  cd "$target_dir"
}

# clone git repo without history
clone-sparse() {
  local repo_path=${1#*//}
  repo_path=${repo_path#www.}
  local target_dir="$HOME/code/${repo_path%.git}"

  if [[ ! -d "$target_dir" ]]; then
    mkdir -p "${target_dir:h}" && git clone --depth 1 "$1" "$target_dir"
  fi

  cd "$target_dir"
}

# find and cd into repo using fzf
repo() {
  local dir=$(
    find "$REPOS" -mindepth 2 -maxdepth 3 -type d |
    sort |
    sed "s|^$REPOS/||" |
    sed 's|^\(.*\)/\([^/]*\)$|\x1b[90m\1/\x1b[0m\2|' |
    fzf --ansi --query="$1" |
    sed 's/\x1b\[[0-9;]*m//g'
  )
  [[ -n "$dir" ]] && cd "$REPOS/$dir"
}

# chat - Start Claude in the chats repo
chat() {
    cd "$GHREPOS/claude-chats"
    claude "$@"
}

# export claude conversation history for all git repos in ~/code
# prints one line per repo that actually exported something (skips no-op / no-history / error cases)
claude-export-all() {
  local gitdir repo_dir rel output n
  find "$REPOS" -type d -name ".git" 2>/dev/null | while read gitdir; do
    repo_dir="${gitdir%/.git}"
    rel="${repo_dir#$REPOS/}"
    output=$(cd "$repo_dir" && claude-export 2>&1)
    [[ "$output" == *"Processed "* ]] || continue
    n=${output##*Processed }
    n=${n%% dates*}
    [[ "$n" == "0" ]] && continue
    if [[ "$n" == "1" ]]; then
      echo "$rel (1 date)"
    else
      echo "$rel ($n dates)"
    fi
  done
}

# show the most recently active repos by claude export history
# lists repos with a .claude/history dir, sorted by their newest history date
# (the date in the filename = the conversation date, which survives re-exports)
# usage: claude-resume [count]   (default 5)
claude-resume() {
  # locals declared once up front; re-declaring inside a loop makes zsh echo them
  local count="${1:-5}"
  local now=$(date +%s)
  local histdir repo_dir rel latest hdate ts days ago
  find "$REPOS" -type d -path '*/.claude/history' 2>/dev/null | while read histdir; do
    repo_dir="${histdir%/.claude/history}"
    rel="${repo_dir#$REPOS/}"
    # newest YYYY-MM-DD encoded in a history filename
    # (glob, not `ls`: the ls alias -> eza is baked in at function definition time)
    latest=$(print -rl -- "$histdir"/*(N:t) | grep -oE '^[0-9]{4}-[0-9]{2}-[0-9]{2}' | sort -r | head -1)
    [[ -n "$latest" ]] && printf '%s\t%s\n' "$latest" "$rel"
  done | sort -r | head -n "$count" | while IFS=$'\t' read hdate rel; do
    ts=$(date -d "$hdate" +%s)
    days=$(( (now - ts) / 86400 ))
    if [[ $days -eq 0 ]]; then ago="today"
    elif [[ $days -eq 1 ]]; then ago="yesterday"
    else ago="$days days ago"; fi
    printf '%-12s %-45s (%s)\n' "$hdate" "$rel" "$ago"
  done
}